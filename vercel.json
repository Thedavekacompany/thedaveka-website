{
  "redirects": [
    {
      "source": "/app",
      "destination": "https://app.thedaveka.com",
      "permanent": false
    },
    {
      "source": "/app/:path*",
      "destination": "https://app.thedaveka.com/app/:path*",
      "permanent": false
    },
    {
      "source": "/sentinel",
      "destination": "https://app.thedaveka.com",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/brand/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "cleanUrls": true
}
